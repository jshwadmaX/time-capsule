# ============================================================
# Next-Gen Time Capsule — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Gmail SMTP Credentials ---
# The Gmail account used to send time capsule emails.
# Use an App Password (not your account password) if 2FA is enabled.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# --- Encryption Secret ---
# A random secret string used to encrypt saved capsule data.
# Change this to a long, random value in production.
ENCRYPTION_SECRET=change-me-to-a-long-random-secret-string
